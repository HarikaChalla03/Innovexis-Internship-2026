      <aliases enabled='yes' />
      <column datatype='string' name='[Aircraft]' role='dimension' type='nominal' />
      <column caption='Cabin staff service' datatype='integer' name='[Cabin_staff_service]' role='measure' type='quantitative' />
      <column caption='Overall Rating' datatype='real' name='[Calculation_1234267796658606080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Rating])' />
      </column>
      <column caption='Recommendation Rate' datatype='real' default-format='p0.00%' name='[Calculation_1234267796658987009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Recommended] = &quot;yes&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([Recommended])' />
      </column>
      <column caption='Total Reviews' datatype='integer' name='[Calculation_1234267796659429378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[ba_reviews.csv_41F6B606CDF44143A3ADDAAB3DF9A355])' />
      </column>
      <column caption='Average Value for Money' datatype='real' name='[Calculation_1234267796664950787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Value_for_money])' />
      </column>
      <column caption='Seat Comfort Rating' datatype='real' name='[Calculation_1234267796666781700]' role='measure' type='quantitative'>
