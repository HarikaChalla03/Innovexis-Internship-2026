        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97856' id='55' param='horz' type-v2='layout-flow' w='99150' x='425' y='1072'>
            <zone h='97856' id='15' param='vert' type-v2='layout-flow' w='88204' x='425' y='1072'>
              <zone h='8981' id='16' type-v2='title' w='88204' x='425' y='1072'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='88875' id='13' type-v2='layout-basic' w='88204' x='425' y='10053'>
                <zone h='21670' id='7' name='Recommendation Rate' w='22677' x='65952' y='10053'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='21670' id='8' name='Total Reviews' w='18768' x='425' y='10053'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='21670' id='9' name='Average Value for Money' w='24336' x='41616' y='10053'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='67205' id='10' name='Overall Rating Trend' w='27188' x='425' y='31723'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
