    <worksheet name='Recommendation Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Arial' fontsize='14'>Recommendation Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ba_reviews+ (Multiple Connections)' name='federated.1td1uqp1x9vgmy17ibyru0v3cmss' />
          </datasources>
          <datasource-dependencies datasource='federated.1td1uqp1x9vgmy17ibyru0v3cmss'>
            <column caption='Recommendation Rate' datatype='real' default-format='p0.00%' name='[Calculation_1234267796658987009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Recommended] = &quot;yes&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/COUNT([Recommended])' />
            </column>
            <column caption='Date Flown' datatype='date' name='[Date_Flown]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Recommended]' role='dimension' type='nominal' />
            <column-instance column='[Recommended]' derivation='None' name='[none:Recommended:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1234267796658987009]' derivation='User' name='[usr:Calculation_1234267796658987009:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Date_Flown]' derivation='Year' name='[yr:Date_Flown:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1td1uqp1x9vgmy17ibyru0v3cmss].[Action (YEAR(Date Flown))]'>
            <groupfilter function='level-members' level='[yr:Date_Flown:ok]' user:ui-action-filter='[Action3_B64058A5FB084626AA2713BE965CB155]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1td1uqp1x9vgmy17ibyru0v3cmss].[none:Recommended:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Recommended:nk]' member='&quot;no&quot;' />
              <groupfilter function='member' level='[none:Recommended:nk]' member='&quot;yes&quot;' />
            </groupfilter>
          </filter>
